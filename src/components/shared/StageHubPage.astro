---
import Layout from '../../layouts/Layout.astro';

interface Section {
  id: string;
  name: string;
  category: string;
  triggers?: string;
}

interface StageType {
  key: string;
  name: string;
  sections: Section[];
  color: string;
}

interface NavLink {
  href: string;
  label: string;
  color: string;
}

interface Props {
  title: string;
  urlPrefix: string;
  stageTypes: StageType[];
  navLinks?: NavLink[];
  backgroundGradient: string;
  hoverColor?: string;
}

const {
  title,
  urlPrefix,
  stageTypes,
  navLinks = [],
  backgroundGradient,
  hoverColor = 'rgba(255, 255, 255, 0.5)'
} = Astro.props;
---

<Layout title={title}>
  <style>
    body { overflow: auto !important; }
  </style>
  <div style={`min-height: 100vh; background: ${backgroundGradient}; padding: 2rem; padding-bottom: 4rem;`}>
    <div style="max-width: 1200px; margin: 0 auto;">
      <h1 style="color: white; font-family: monospace; margin-bottom: 2rem; text-align: center;">
        {title}
      </h1>

      {navLinks.length > 0 && (
        <div style="margin-bottom: 2rem; text-align: center;">
          {navLinks.map(link => (
            <a
              href={link.href}
              style={`
                display: inline-block;
                padding: 0.75rem 1.5rem;
                background: ${link.color};
                color: white;
                text-decoration: none;
                border-radius: 8px;
                font-family: monospace;
                margin: 0 0.5rem;
              `}
            >
              {link.label}
            </a>
          ))}
        </div>
      )}

      {stageTypes.map(stageType => (
        <div key={stageType.key} style="margin-bottom: 3rem;">
          <h2 style={`
            color: white;
            font-family: monospace;
            font-size: 1.4rem;
            margin-bottom: 1.5rem;
            padding: 0.75rem 1rem;
            background: ${stageType.color};
            border-radius: 8px;
          `}>
            {stageType.name}
          </h2>
          <div style="
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 1rem;
          ">
            {stageType.sections.map(section => (
              <a
                key={section.id}
                href={`/stage/${urlPrefix}-${section.id}`}
                class="section-link"
                data-hover-color={hoverColor}
                style="
                  display: block;
                  padding: 1rem;
                  background: rgba(255, 255, 255, 0.1);
                  color: white;
                  text-decoration: none;
                  border-radius: 8px;
                  font-family: monospace;
                  transition: all 0.3s ease;
                  border: 2px solid transparent;
                "
              >
                <div style="font-weight: bold; margin-bottom: 0.25rem;">
                  {section.name}
                </div>
                <div style="font-size: 0.85rem; color: rgba(255, 255, 255, 0.7);">
                  {section.id}
                </div>
                {section.triggers && (
                  <div style="font-size: 0.75rem; color: rgba(100, 255, 100, 0.8); margin-top: 0.5rem;">
                    🚪 {section.triggers}
                  </div>
                )}
              </a>
            ))}
          </div>
        </div>
      ))}

      <div style="text-align: center; margin-top: 3rem;">
        <a
          href="/"
          style="
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background: rgba(200, 50, 50, 0.9);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-family: monospace;
          "
        >
          Back to Home
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  document.querySelectorAll('.section-link').forEach(link => {
    const hoverColor = link.getAttribute('data-hover-color') || 'rgba(255, 255, 255, 0.5)';
    link.addEventListener('mouseover', () => {
      (link as HTMLElement).style.background = 'rgba(255, 255, 255, 0.2)';
      (link as HTMLElement).style.borderColor = hoverColor;
    });
    link.addEventListener('mouseout', () => {
      (link as HTMLElement).style.background = 'rgba(255, 255, 255, 0.1)';
      (link as HTMLElement).style.borderColor = 'transparent';
    });
  });
</script>
