---

<StageHubPage
  title="Arca Plant - All Sections"
  urlPrefix="arca"
  stageTypes={stageTypes}
  navLinks={navLinks}
  backgroundGradient="linear-gradient(135deg, #1a1a1a 0%, #2a2525 100%)"
  hoverColor="rgba(200, 170, 100, 0.5)"
/>
