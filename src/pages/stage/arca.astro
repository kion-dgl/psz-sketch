---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

// Arca A - First set of stages
const arcaASections = [
  { id: 's06a_ga1', name: 'Gateway', category: 'Gateway' },
  { id: 's06a_ib1', name: 'Inner Bridge 1', category: 'Inner' },
  { id: 's06a_ib2', name: 'Inner Bridge 2', category: 'Inner' },
  { id: 's06a_ic1', name: 'Inner Canyon 1', category: 'Inner' },
  { id: 's06a_ic3', name: 'Inner Canyon 3', category: 'Inner' },
  { id: 's06a_lb1', name: 'Lower Bridge 1', category: 'Lower' },
  { id: 's06a_lb3', name: 'Lower Bridge 3', category: 'Lower' },
  { id: 's06a_lc1', name: 'Lower Canyon 1', category: 'Lower' },
  { id: 's06a_lc2', name: 'Lower Canyon 2', category: 'Lower' },
  { id: 's06a_na1', name: 'North Area 1', category: 'North' },
  { id: 's06a_nb2', name: 'North Bridge 2', category: 'North' },
  { id: 's06a_nc2', name: 'North Canyon 2', category: 'North' },
  { id: 's06a_sa1', name: 'South Area 1', category: 'South' },
  { id: 's06a_tb3', name: 'Top Bridge 3', category: 'Top' },
  { id: 's06a_tc3', name: 'Top Canyon 3', category: 'Top' },
  { id: 's06a_td1', name: 'Top Domain 1', category: 'Top' },
  { id: 's06a_td2', name: 'Top Domain 2', category: 'Top' },
  { id: 's06a_xb2', name: 'East Bridge 2', category: 'East' },
];

// Arca E - Midpoint
const arcaESections = [
  { id: 's06e_ia1', name: 'Inner Area 1', category: 'Midpoint' },
];

// Arca B - Second set of stages
const arcaBSections = [
  { id: 's06b_ga1', name: 'Gateway', category: 'Gateway' },
  { id: 's06b_ib1', name: 'Inner Bridge 1', category: 'Inner' },
  { id: 's06b_ib2', name: 'Inner Bridge 2', category: 'Inner' },
  { id: 's06b_ic1', name: 'Inner Canyon 1', category: 'Inner' },
  { id: 's06b_ic3', name: 'Inner Canyon 3', category: 'Inner' },
  { id: 's06b_lb1', name: 'Lower Bridge 1', category: 'Lower' },
  { id: 's06b_lb3', name: 'Lower Bridge 3', category: 'Lower' },
  { id: 's06b_lc1', name: 'Lower Canyon 1', category: 'Lower' },
  { id: 's06b_lc2', name: 'Lower Canyon 2', category: 'Lower' },
  { id: 's06b_na1', name: 'North Area 1', category: 'North' },
  { id: 's06b_nb2', name: 'North Bridge 2', category: 'North' },
  { id: 's06b_nc2', name: 'North Canyon 2', category: 'North' },
  { id: 's06b_sa1', name: 'South Area 1', category: 'South' },
  { id: 's06b_tb3', name: 'Top Bridge 3', category: 'Top' },
  { id: 's06b_tc3', name: 'Top Canyon 3', category: 'Top' },
  { id: 's06b_td1', name: 'Top Domain 1', category: 'Top' },
  { id: 's06b_td2', name: 'Top Domain 2', category: 'Top' },
  { id: 's06b_xb2', name: 'East Bridge 2', category: 'East' },
];

// Arca Z - Boss area
const arcaZSections = [
  { id: 's06z_na1', name: 'North Area 1', category: 'Boss' },
];

const arcaTypes = [
  { key: 'a', name: 'Arca Plant A - First Set', sections: arcaASections, color: '#3a3a3a' },
  { key: 'e', name: 'Arca Plant E - Midpoint', sections: arcaESections, color: '#4a4545' },
  { key: 'b', name: 'Arca Plant B - Second Set', sections: arcaBSections, color: '#3a3535' },
  { key: 'z', name: 'Arca Plant Z - Boss Area', sections: arcaZSections, color: '#4a3030' },
];
---

<Layout title="Arca Plant - All Sections">
  <style>
    body { overflow: auto !important; }
  </style>
  <div style="min-height: 100vh; background: linear-gradient(135deg, #1a1a1a 0%, #2a2525 100%); padding: 2rem; padding-bottom: 4rem;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <h1 style="color: white; font-family: monospace; margin-bottom: 2rem; text-align: center;">
        Arca Plant - All Sections
      </h1>

      <div style="margin-bottom: 2rem; text-align: center;">
        <a
          href="/stage/paru"
          style="
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background: rgba(40, 80, 40, 0.9);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-family: monospace;
            margin: 0 0.5rem;
          "
        >
          Back to Oblivion City
        </a>
        <a
          href="/stage/wetlands"
          style="
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background: rgba(45, 80, 22, 0.9);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-family: monospace;
            margin: 0 0.5rem;
          "
        >
          Back to Wetlands
        </a>
        <a
          href="/stage/warp"
          style="
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background: rgba(100, 50, 150, 0.9);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-family: monospace;
            margin: 0 0.5rem;
          "
        >
          Back to Warp
        </a>
      </div>

      {arcaTypes.map(arcaType => (
        <div key={arcaType.key} style="margin-bottom: 3rem;">
          <h2 style={`
            color: white;
            font-family: monospace;
            font-size: 1.4rem;
            margin-bottom: 1.5rem;
            padding: 0.75rem 1rem;
            background: ${arcaType.color};
            border-radius: 8px;
          `}>
            {arcaType.name}
          </h2>
          <div style="
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 1rem;
          ">
            {arcaType.sections.map(section => (
              <a
                key={section.id}
                href={`/stage/arca-${section.id}`}
                style="
                  display: block;
                  padding: 1rem;
                  background: rgba(255, 255, 255, 0.1);
                  color: white;
                  text-decoration: none;
                  border-radius: 8px;
                  font-family: monospace;
                  transition: all 0.3s ease;
                  border: 2px solid transparent;
                "
                onmouseover="this.style.background='rgba(255, 255, 255, 0.2)'; this.style.borderColor='rgba(200, 170, 100, 0.5)';"
                onmouseout="this.style.background='rgba(255, 255, 255, 0.1)'; this.style.borderColor='transparent';"
              >
                <div style="font-weight: bold; margin-bottom: 0.25rem;">
                  {section.name}
                </div>
                <div style="font-size: 0.85rem; color: rgba(255, 255, 255, 0.7);">
                  {section.id}
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}

      <div style="text-align: center; margin-top: 3rem;">
        <a
          href="/"
          style="
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background: rgba(150, 120, 80, 0.9);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-family: monospace;
          "
        >
          Back to Home
        </a>
      </div>
    </div>
  </div>
</Layout>
