---
import Layout from '../../layouts/Layout.astro';
import ValleyArea from '../../components/valley/ValleyArea';

export const prerender = false;
---

<Layout title="Gurhacia Valley - Gateway">
  <ValleyArea
    mapId="s01a_ga1"
    mapName="Gurhacia Valley - Gateway"
    triggers={[
      {
        position: [2.03, 1.00, -20.14],
        targetUrl: "/stage/valley",
        label: "North Exit"
      },
      {
        position: [-5.91, 1.00, 33.99],
        targetUrl: "/stage/valley",
        label: "South Exit"
      }
    ]}
    client:load
  />
</Layout>
