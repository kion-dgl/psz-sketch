---
import Layout from '../../layouts/Layout.astro';
import ValleyArea from '../../components/valley/ValleyArea';

export const prerender = false;

// Stage objects - north gate is blocked until switch is activated
const objects = {
  gates: [
    { id: "north_gate", edge: "north" as const, x: 2, z: -27, scale: 1, blocked: true },
  ],
  boxes: [
    { x: 12.84, z: 6.86, boxType: "valley_cont" as const, texture: { wrapS: "mirror" as const, wrapT: "mirror" as const, repeatX: 2, repeatY: 2 } },
    { x: 10.49, z: 6.97, boxType: "valley_cont" as const, texture: { wrapS: "mirror" as const, wrapT: "mirror" as const, repeatX: 2, repeatY: 2 } },
    { x: 11.45, z: 5.20, boxType: "valley_recont" as const, texture: { wrapS: "mirror" as const, wrapT: "mirror" as const, offsetY: 1, repeatX: 2, repeatY: 2 } },
  ],
  switches: [
    { x: 5.54, z: -9.73, switchType: "valley_switchf" as const, targetGateId: "north_gate", label: "Gate Switch" },
  ],
};

// Spawn points for debug markers
const spawnPoints = [
  { position: [-6, 1, 24] as [number, number, number], rotation: Math.PI, label: "South Gate" },
  { position: [2, 1, -24] as [number, number, number], rotation: 0, label: "North Gate" },
];

// Always active triggers
const triggers = [
  { position: [-6, 1, 29] as [number, number, number], rotation: Math.PI, targetUrl: "/stage/valley", label: "South Gate" },
];

// Triggers that activate when a gate is unlocked by switch
const lockedTriggers = [
  {
    gateId: "north_gate",
    trigger: { position: [2, 1, -29] as [number, number, number], rotation: 0, targetUrl: "/stage/valley", label: "North Gate" },
  },
];
---

<Layout title="Gurhacia Valley - s01a_ga1">
  <ValleyArea
    mapId="s01a_ga1"
    mapName="Gurhacia Valley - s01a_ga1"
    spawnPosition={[-6, 1, 24]}
    spawnRotation={Math.PI}
    spawnPoints={spawnPoints}
    triggers={triggers}
    lockedTriggers={lockedTriggers}
    objects={objects}
    client:load
  />
</Layout>
