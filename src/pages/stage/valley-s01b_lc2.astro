---
import Layout from '../../layouts/Layout.astro';
import ValleyArea from '../../components/valley/ValleyArea';

export const prerender = false;

const objects = {
  gates: [
    { edge: "north" as const, x: 10, z: -27, scale: 1 },
    { edge: "east" as const, x: 27, z: 15.5, scale: 1 },
  ],
};

const spawnPoints = [
  { position: [10, 1, -24] as [number, number, number], rotation: 0, label: "North Gate" },
  { position: [24, 1, 15.5] as [number, number, number], rotation: -1.5707963267948966, label: "East Gate" },
];

const triggers = [
  { position: [10, 1, -29] as [number, number, number], rotation: 0, targetUrl: "/stage/valley", label: "North Gate" },
  { position: [29, 1, 15.5] as [number, number, number], rotation: -1.5707963267948966, targetUrl: "/stage/valley", label: "East Gate" },
];
---

<Layout title="Gurhacia Valley - s01b_lc2">
  <ValleyArea
    mapId="s01b_lc2"
    mapName="Gurhacia Valley - s01b_lc2"
    spawnPosition={spawnPoints[0].position}
    spawnRotation={spawnPoints[0].rotation}
    spawnPoints={spawnPoints}
    triggers={triggers}
    objects={objects}
    client:load
  />
</Layout>
