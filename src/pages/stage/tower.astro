---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const tower0Sections = [
  { id: 's080_sa0', name: 'Starting Area', category: 'Ground' },
];

const tower1Sections = [
  { id: 's081_ga1', name: 'Gateway 1', category: 'Entrance' },
  { id: 's081_sa1', name: 'South Area 1', category: 'South' },
  { id: 's081_ib1', name: 'Inner Bridge 1', category: 'Inner' },
  { id: 's081_lb1', name: 'Lower Bridge 1', category: 'Lower' },
];

const tower2Sections = [
  { id: 's082_ga1', name: 'Gateway 1', category: 'Entrance' },
  { id: 's082_sa1', name: 'South Area 1', category: 'South' },
  { id: 's082_ib1', name: 'Inner Bridge 1', category: 'Inner' },
  { id: 's082_lb1', name: 'Lower Bridge 1', category: 'Lower' },
];

const tower3Sections = [
  { id: 's083_ga1', name: 'Gateway 1', category: 'Entrance' },
  { id: 's083_sa1', name: 'South Area 1', category: 'South' },
  { id: 's083_ib1', name: 'Inner Bridge 1', category: 'Inner' },
  { id: 's083_lb1', name: 'Lower Bridge 1', category: 'Lower' },
];

const tower4Sections = [
  { id: 's084_ga1', name: 'Gateway 1', category: 'Entrance' },
  { id: 's084_sa1', name: 'South Area 1', category: 'South' },
  { id: 's084_ib1', name: 'Inner Bridge 1', category: 'Inner' },
  { id: 's084_lb1', name: 'Lower Bridge 1', category: 'Lower' },
];

const tower5Sections = [
  { id: 's085_ga1', name: 'Gateway 1', category: 'Entrance' },
  { id: 's085_sa1', name: 'South Area 1', category: 'South' },
  { id: 's085_ib1', name: 'Inner Bridge 1', category: 'Inner' },
  { id: 's085_lb1', name: 'Lower Bridge 1', category: 'Lower' },
];

const tower6Sections = [
  { id: 's086_ga1', name: 'Gateway 1', category: 'Entrance' },
  { id: 's086_sa1', name: 'South Area 1', category: 'South' },
  { id: 's086_ib1', name: 'Inner Bridge 1', category: 'Inner' },
  { id: 's086_lb1', name: 'Lower Bridge 1', category: 'Lower' },
];

const tower7Sections = [
  { id: 's087_na1', name: 'North Area 1', category: 'Summit' },
];

const towerESections = [
  { id: 's08e_ib1', name: 'Inner Bridge 1', category: 'Elevator' },
];

const towerFloors = [
  { key: '0', name: 'Floor 0 - Ground Level', sections: tower0Sections, color: '#3a3020' },
  { key: '1', name: 'Floor 1 - First Level', sections: tower1Sections, color: '#3a3525' },
  { key: '2', name: 'Floor 2 - Second Level', sections: tower2Sections, color: '#3a382a' },
  { key: '3', name: 'Floor 3 - Third Level', sections: tower3Sections, color: '#3a3a30' },
  { key: '4', name: 'Floor 4 - Fourth Level', sections: tower4Sections, color: '#383a35' },
  { key: '5', name: 'Floor 5 - Fifth Level', sections: tower5Sections, color: '#353a38' },
  { key: '6', name: 'Floor 6 - Sixth Level', sections: tower6Sections, color: '#303a3a' },
  { key: '7', name: 'Floor 7 - Summit', sections: tower7Sections, color: '#4a3a20' },
  { key: 'e', name: 'Elevator - Central Shaft', sections: towerESections, color: '#2a3040' },
];
---

<Layout title="Eternal Tower - All Floors">
  <style>
    body { overflow: auto !important; }
  </style>
  <div style="min-height: 100vh; background: linear-gradient(135deg, #1a1510 0%, #2a2520 100%); padding: 2rem; padding-bottom: 4rem;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <h1 style="color: white; font-family: monospace; margin-bottom: 2rem; text-align: center;">
        Eternal Tower - All Floors
      </h1>

      <div style="margin-bottom: 2rem; text-align: center;">
        <a href="/stage/warp" style="display: inline-block; padding: 0.75rem 1.5rem; background: rgba(100, 50, 150, 0.9); color: white; text-decoration: none; border-radius: 8px; font-family: monospace; margin: 0 0.5rem;">
          Back to Warp
        </a>
        <a href="/stage/tower-debug" style="display: inline-block; padding: 0.75rem 1.5rem; background: rgba(200, 100, 50, 0.9); color: white; text-decoration: none; border-radius: 8px; font-family: monospace; margin: 0 0.5rem;">
          Texture Debug
        </a>
        <a href="/stage/tower-trigger-debug" style="display: inline-block; padding: 0.75rem 1.5rem; background: rgba(50, 150, 200, 0.9); color: white; text-decoration: none; border-radius: 8px; font-family: monospace; margin: 0 0.5rem;">
          Trigger Debug
        </a>
      </div>

      {towerFloors.map(floor => (
        <div key={floor.key} style="margin-bottom: 3rem;">
          <h2 style={`color: white; font-family: monospace; font-size: 1.4rem; margin-bottom: 1.5rem; padding: 0.75rem 1rem; background: ${floor.color}; border-radius: 8px;`}>
            {floor.name}
          </h2>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1rem;">
            {floor.sections.map(section => (
              <a key={section.id} href={`/stage/tower-${section.id}`} style="display: block; padding: 1rem; background: rgba(255, 255, 255, 0.1); color: white; text-decoration: none; border-radius: 8px; font-family: monospace; transition: all 0.3s ease; border: 2px solid transparent;" onmouseover="this.style.background='rgba(255, 255, 255, 0.2)'; this.style.borderColor='rgba(200, 180, 100, 0.5)';" onmouseout="this.style.background='rgba(255, 255, 255, 0.1)'; this.style.borderColor='transparent';">
                <div style="font-weight: bold; margin-bottom: 0.25rem;">{section.name}</div>
                <div style="font-size: 0.85rem; color: rgba(255, 255, 255, 0.7);">{section.id}</div>
              </a>
            ))}
          </div>
        </div>
      ))}

      <div style="text-align: center; margin-top: 3rem;">
        <a href="/" style="display: inline-block; padding: 0.75rem 1.5rem; background: rgba(180, 150, 80, 0.9); color: white; text-decoration: none; border-radius: 8px; font-family: monospace;">
          Back to Home
        </a>
      </div>
    </div>
  </div>
</Layout>
