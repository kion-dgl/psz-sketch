---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const shrineASections = [
  { id: 's07a_ga1', name: 'Gateway', category: 'Gateway' },
  { id: 's07a_ib1', name: 'Inner Bridge 1', category: 'Inner' },
  { id: 's07a_ib2', name: 'Inner Bridge 2', category: 'Inner' },
  { id: 's07a_ic1', name: 'Inner Canyon 1', category: 'Inner' },
  { id: 's07a_ic3', name: 'Inner Canyon 3', category: 'Inner' },
  { id: 's07a_lb1', name: 'Lower Bridge 1', category: 'Lower' },
  { id: 's07a_lb3', name: 'Lower Bridge 3', category: 'Lower' },
  { id: 's07a_lc1', name: 'Lower Canyon 1', category: 'Lower' },
  { id: 's07a_lc2', name: 'Lower Canyon 2', category: 'Lower' },
  { id: 's07a_na1', name: 'North Area 1', category: 'North' },
  { id: 's07a_nb2', name: 'North Bridge 2', category: 'North' },
  { id: 's07a_nc2', name: 'North Canyon 2', category: 'North' },
  { id: 's07a_sa1', name: 'South Area 1', category: 'South' },
  { id: 's07a_tb3', name: 'Top Bridge 3', category: 'Top' },
  { id: 's07a_tc3', name: 'Top Canyon 3', category: 'Top' },
  { id: 's07a_td1', name: 'Top Domain 1', category: 'Top' },
  { id: 's07a_td2', name: 'Top Domain 2', category: 'Top' },
  { id: 's07a_xb2', name: 'East Bridge 2', category: 'East' },
];

const shrineESections = [
  { id: 's07e_ia1', name: 'Inner Area 1', category: 'Midpoint' },
];

const shrineBSections = [
  { id: 's07b_ga1', name: 'Gateway', category: 'Gateway' },
  { id: 's07b_ib1', name: 'Inner Bridge 1', category: 'Inner' },
  { id: 's07b_ib2', name: 'Inner Bridge 2', category: 'Inner' },
  { id: 's07b_ic1', name: 'Inner Canyon 1', category: 'Inner' },
  { id: 's07b_ic3', name: 'Inner Canyon 3', category: 'Inner' },
  { id: 's07b_lb1', name: 'Lower Bridge 1', category: 'Lower' },
  { id: 's07b_lb3', name: 'Lower Bridge 3', category: 'Lower' },
  { id: 's07b_lc1', name: 'Lower Canyon 1', category: 'Lower' },
  { id: 's07b_lc2', name: 'Lower Canyon 2', category: 'Lower' },
  { id: 's07b_na1', name: 'North Area 1', category: 'North' },
  { id: 's07b_nb2', name: 'North Bridge 2', category: 'North' },
  { id: 's07b_nc2', name: 'North Canyon 2', category: 'North' },
  { id: 's07b_sa1', name: 'South Area 1', category: 'South' },
  { id: 's07b_tb3', name: 'Top Bridge 3', category: 'Top' },
  { id: 's07b_tc3', name: 'Top Canyon 3', category: 'Top' },
  { id: 's07b_td1', name: 'Top Domain 1', category: 'Top' },
  { id: 's07b_td2', name: 'Top Domain 2', category: 'Top' },
  { id: 's07b_xb2', name: 'East Bridge 2', category: 'East' },
];

const shrineZSections = [
  { id: 's07z_na1', name: 'North Area 1', category: 'Boss' },
  { id: 's07z_na2', name: 'North Area 2', category: 'Boss' },
];

const shrineTypes = [
  { key: 'a', name: 'Dark Shrine A - First Set', sections: shrineASections, color: '#2a2a3a' },
  { key: 'e', name: 'Dark Shrine E - Midpoint', sections: shrineESections, color: '#252530' },
  { key: 'b', name: 'Dark Shrine B - Second Set', sections: shrineBSections, color: '#282835' },
  { key: 'z', name: 'Dark Shrine Z - Boss Area', sections: shrineZSections, color: '#301530' },
];
---

<Layout title="Dark Shrine - All Sections">
  <style>
    body { overflow: auto !important; }
  </style>
  <div style="min-height: 100vh; background: linear-gradient(135deg, #0a0a15 0%, #1a1a2a 100%); padding: 2rem; padding-bottom: 4rem;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <h1 style="color: white; font-family: monospace; margin-bottom: 2rem; text-align: center;">
        Dark Shrine - All Sections
      </h1>

      <div style="margin-bottom: 2rem; text-align: center;">
        <a href="/stage/warp" style="display: inline-block; padding: 0.75rem 1.5rem; background: rgba(100, 50, 150, 0.9); color: white; text-decoration: none; border-radius: 8px; font-family: monospace; margin: 0 0.5rem;">
          Back to Warp
        </a>
        <a href="/stage/shrine-debug" style="display: inline-block; padding: 0.75rem 1.5rem; background: rgba(200, 100, 50, 0.9); color: white; text-decoration: none; border-radius: 8px; font-family: monospace; margin: 0 0.5rem;">
          Texture Debug
        </a>
        <a href="/stage/shrine-trigger-debug" style="display: inline-block; padding: 0.75rem 1.5rem; background: rgba(50, 150, 200, 0.9); color: white; text-decoration: none; border-radius: 8px; font-family: monospace; margin: 0 0.5rem;">
          Trigger Debug
        </a>
      </div>

      {shrineTypes.map(shrineType => (
        <div key={shrineType.key} style="margin-bottom: 3rem;">
          <h2 style={`color: white; font-family: monospace; font-size: 1.4rem; margin-bottom: 1.5rem; padding: 0.75rem 1rem; background: ${shrineType.color}; border-radius: 8px;`}>
            {shrineType.name}
          </h2>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1rem;">
            {shrineType.sections.map(section => (
              <a key={section.id} href={`/stage/shrine-${section.id}`} style="display: block; padding: 1rem; background: rgba(255, 255, 255, 0.1); color: white; text-decoration: none; border-radius: 8px; font-family: monospace; transition: all 0.3s ease; border: 2px solid transparent;" onmouseover="this.style.background='rgba(255, 255, 255, 0.2)'; this.style.borderColor='rgba(150, 100, 200, 0.5)';" onmouseout="this.style.background='rgba(255, 255, 255, 0.1)'; this.style.borderColor='transparent';">
                <div style="font-weight: bold; margin-bottom: 0.25rem;">{section.name}</div>
                <div style="font-size: 0.85rem; color: rgba(255, 255, 255, 0.7);">{section.id}</div>
              </a>
            ))}
          </div>
        </div>
      ))}

      <div style="text-align: center; margin-top: 3rem;">
        <a href="/" style="display: inline-block; padding: 0.75rem 1.5rem; background: rgba(100, 80, 150, 0.9); color: white; text-decoration: none; border-radius: 8px; font-family: monospace;">
          Back to Home
        </a>
      </div>
    </div>
  </div>
</Layout>
