---
import Layout from '../../layouts/Layout.astro';
import ValleyArea from '../../components/valley/ValleyArea';

export const prerender = false;

const objects = {
  gates: [
    { edge: "north" as const, x: -17, z: -26, scale: 1 },
    { edge: "east" as const, x: 26, z: -17, scale: 1 },
  ],
};

const spawnPoints = [
  { position: [-17, 1, -23] as [number, number, number], rotation: 0, label: "North Gate" },
  { position: [23, 1, -17] as [number, number, number], rotation: -1.5707963267948966, label: "East Gate" },
];

const triggers = [
  { position: [-17, 1, -28] as [number, number, number], rotation: 0, targetUrl: "/stage/valley", label: "North Gate" },
  { position: [28, 1, -17] as [number, number, number], rotation: -1.5707963267948966, targetUrl: "/stage/valley", label: "East Gate" },
];
---

<Layout title="Gurhacia Valley - s01b_lb3">
  <ValleyArea
    mapId="s01b_lb3"
    mapName="Gurhacia Valley - s01b_lb3"
    spawnPosition={spawnPoints[0].position}
    spawnRotation={spawnPoints[0].rotation}
    spawnPoints={spawnPoints}
    triggers={triggers}
    objects={objects}
    client:load
  />
</Layout>
