---
import Layout from '../../layouts/Layout.astro';
import ValleyArea from '../../components/valley/ValleyArea';

export const prerender = false;

const objects = {
  gates: [
    { edge: "north" as const, x: -19, z: -27, scale: 1 },
    { edge: "south" as const, x: 19, z: 27, scale: 1 },
  ],
};

const spawnPoints = [
  { position: [-19, 1, -24] as [number, number, number], rotation: 0, label: "North Gate" },
  { position: [19, 1, 24] as [number, number, number], rotation: 3.141592653589793, label: "South Gate" },
];

const triggers = [
  { position: [-19, 1, -29] as [number, number, number], rotation: 0, targetUrl: "/stage/valley", label: "North Gate" },
  { position: [19, 1, 29] as [number, number, number], rotation: 3.141592653589793, targetUrl: "/stage/valley", label: "South Gate" },
];
---

<Layout title="Gurhacia Valley - s01a_ic3">
  <ValleyArea
    mapId="s01a_ic3"
    mapName="Gurhacia Valley - s01a_ic3"
    spawnPosition={spawnPoints[0].position}
    spawnRotation={spawnPoints[0].rotation}
    spawnPoints={spawnPoints}
    triggers={triggers}
    objects={objects}
    client:load
  />
</Layout>
