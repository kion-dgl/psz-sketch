---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

// Makara A - First set of stages
const makaraASections = [
  { id: 's04a_ga1', name: 'Gateway', category: 'Gateway' },
  { id: 's04a_ib1', name: 'Inner Bridge 1', category: 'Inner' },
  { id: 's04a_ib2', name: 'Inner Bridge 2', category: 'Inner' },
  { id: 's04a_ic1', name: 'Inner Canyon 1', category: 'Inner' },
  { id: 's04a_ic3', name: 'Inner Canyon 3', category: 'Inner' },
  { id: 's04a_lb1', name: 'Lower Bridge 1', category: 'Lower' },
  { id: 's04a_lb3', name: 'Lower Bridge 3', category: 'Lower' },
  { id: 's04a_lc1', name: 'Lower Canyon 1', category: 'Lower' },
  { id: 's04a_lc2', name: 'Lower Canyon 2', category: 'Lower' },
  { id: 's04a_na1', name: 'North Area 1', category: 'North' },
  { id: 's04a_nb2', name: 'North Bridge 2', category: 'North' },
  { id: 's04a_nc2', name: 'North Canyon 2', category: 'North' },
  { id: 's04a_sa1', name: 'South Area 1', category: 'South' },
  { id: 's04a_tb3', name: 'Top Bridge 3', category: 'Top' },
  { id: 's04a_tc3', name: 'Top Canyon 3', category: 'Top' },
  { id: 's04a_td1', name: 'Top Domain 1', category: 'Top' },
  { id: 's04a_td2', name: 'Top Domain 2', category: 'Top' },
  { id: 's04a_xb2', name: 'East Bridge 2', category: 'East' },
];

// Makara E - Midpoint
const makaraESections = [
  { id: 's04e_ia1', name: 'Inner Area 1', category: 'Midpoint' },
];

// Makara B - Second set of stages
const makaraBSections = [
  { id: 's04b_ga1', name: 'Gateway', category: 'Gateway' },
  { id: 's04b_ib1', name: 'Inner Bridge 1', category: 'Inner' },
  { id: 's04b_ib2', name: 'Inner Bridge 2', category: 'Inner' },
  { id: 's04b_ic1', name: 'Inner Canyon 1', category: 'Inner' },
  { id: 's04b_ic3', name: 'Inner Canyon 3', category: 'Inner' },
  { id: 's04b_lb1', name: 'Lower Bridge 1', category: 'Lower' },
  { id: 's04b_lb3', name: 'Lower Bridge 3', category: 'Lower' },
  { id: 's04b_lc1', name: 'Lower Canyon 1', category: 'Lower' },
  { id: 's04b_lc2', name: 'Lower Canyon 2', category: 'Lower' },
  { id: 's04b_na1', name: 'North Area 1', category: 'North' },
  { id: 's04b_nb2', name: 'North Bridge 2', category: 'North' },
  { id: 's04b_nc2', name: 'North Canyon 2', category: 'North' },
  { id: 's04b_sa1', name: 'South Area 1', category: 'South' },
  { id: 's04b_tb3', name: 'Top Bridge 3', category: 'Top' },
  { id: 's04b_tc3', name: 'Top Canyon 3', category: 'Top' },
  { id: 's04b_td1', name: 'Top Domain 1', category: 'Top' },
  { id: 's04b_td2', name: 'Top Domain 2', category: 'Top' },
  { id: 's04b_xb2', name: 'East Bridge 2', category: 'East' },
];

// Makara Z - Boss area
const makaraZSections = [
  { id: 's04z_na1', name: 'North Area 1', category: 'Boss' },
];

const makaraTypes = [
  { key: 'a', name: 'Makara A - First Set', sections: makaraASections, color: '#3a1a1a' },
  { key: 'e', name: 'Makara E - Midpoint', sections: makaraESections, color: '#2a1a2a' },
  { key: 'b', name: 'Makara B - Second Set', sections: makaraBSections, color: '#2a2020' },
  { key: 'z', name: 'Makara Z - Boss Area', sections: makaraZSections, color: '#501616' },
];
---

<Layout title="Makara Ruins - All Sections">
  <style>
    body { overflow: auto !important; }
  </style>
  <div style="min-height: 100vh; background: linear-gradient(135deg, #1a0a0a 0%, #2a1515 100%); padding: 2rem; padding-bottom: 4rem;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <h1 style="color: white; font-family: monospace; margin-bottom: 2rem; text-align: center;">
        Makara Ruins - All Sections
      </h1>

      <div style="margin-bottom: 2rem; text-align: center;">
        <a
          href="/stage/warp"
          style="
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background: rgba(100, 50, 150, 0.9);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-family: monospace;
            margin: 0 0.5rem;
          "
        >
          Back to Warp
        </a>
        <a
          href="/stage/makara-debug"
          style="
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background: rgba(200, 100, 50, 0.9);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-family: monospace;
            margin: 0 0.5rem;
          "
        >
          Texture Debug
        </a>
        <a
          href="/stage/makara-trigger-debug"
          style="
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background: rgba(50, 150, 200, 0.9);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-family: monospace;
            margin: 0 0.5rem;
          "
        >
          Trigger Debug
        </a>
      </div>

      {makaraTypes.map(makaraType => (
        <div key={makaraType.key} style="margin-bottom: 3rem;">
          <h2 style={`
            color: white;
            font-family: monospace;
            font-size: 1.4rem;
            margin-bottom: 1.5rem;
            padding: 0.75rem 1rem;
            background: ${makaraType.color};
            border-radius: 8px;
          `}>
            {makaraType.name}
          </h2>
          <div style="
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 1rem;
          ">
            {makaraType.sections.map(section => (
              <a
                key={section.id}
                href={`/stage/makara-${section.id}`}
                style="
                  display: block;
                  padding: 1rem;
                  background: rgba(255, 255, 255, 0.1);
                  color: white;
                  text-decoration: none;
                  border-radius: 8px;
                  font-family: monospace;
                  transition: all 0.3s ease;
                  border: 2px solid transparent;
                "
                onmouseover="this.style.background='rgba(255, 255, 255, 0.2)'; this.style.borderColor='rgba(255, 255, 255, 0.5)';"
                onmouseout="this.style.background='rgba(255, 255, 255, 0.1)'; this.style.borderColor='transparent';"
              >
                <div style="font-weight: bold; margin-bottom: 0.25rem;">
                  {section.name}
                </div>
                <div style="font-size: 0.85rem; color: rgba(255, 255, 255, 0.7);">
                  {section.id}
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}

      <div style="text-align: center; margin-top: 3rem;">
        <a
          href="/"
          style="
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background: rgba(200, 50, 50, 0.9);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-family: monospace;
          "
        >
          Back to Home
        </a>
      </div>
    </div>
  </div>
</Layout>
