---
import Layout from '../../layouts/Layout.astro';
import ValleyArea from '../../components/valley/ValleyArea';

export const prerender = false;

const objects = {
  gates: [
    { edge: "west" as const, x: -27, z: 16.5, scale: 1 },
    { edge: "south" as const, x: 17, z: 27, scale: 1 },
    { edge: "east" as const, x: 27, z: -14.5, scale: 1 },
  ],
};

const spawnPoints = [
  { position: [-24, 1, 16.5] as [number, number, number], rotation: 1.5707963267948966, label: "West Gate" },
  { position: [17, 1, 24] as [number, number, number], rotation: 3.141592653589793, label: "South Gate" },
  { position: [24, 1, -14.5] as [number, number, number], rotation: -1.5707963267948966, label: "East Gate" },
];

const triggers = [
  { position: [-29, 1, 16.5] as [number, number, number], rotation: 1.5707963267948966, targetUrl: "/stage/valley", label: "West Gate" },
  { position: [17, 1, 29] as [number, number, number], rotation: 3.141592653589793, targetUrl: "/stage/valley", label: "South Gate" },
  { position: [29, 1, -14.5] as [number, number, number], rotation: -1.5707963267948966, targetUrl: "/stage/valley", label: "East Gate" },
];
---

<Layout title="Gurhacia Valley - s01b_tb3">
  <ValleyArea
    mapId="s01b_tb3"
    mapName="Gurhacia Valley - s01b_tb3"
    spawnPosition={spawnPoints[0].position}
    spawnRotation={spawnPoints[0].rotation}
    spawnPoints={spawnPoints}
    triggers={triggers}
    objects={objects}
    client:load
  />
</Layout>
