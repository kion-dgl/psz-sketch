---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

// Snowfield A - First set of stages
const snowfieldASections = [
  { id: 's03a_ga1', name: 'Gateway', category: 'Gateway' },
  { id: 's03a_ib1', name: 'Inner Bridge 1', category: 'Inner' },
  { id: 's03a_ib2', name: 'Inner Bridge 2', category: 'Inner' },
  { id: 's03a_ic1', name: 'Inner Canyon 1', category: 'Inner' },
  { id: 's03a_ic3', name: 'Inner Canyon 3', category: 'Inner' },
  { id: 's03a_lb1', name: 'Lower Bridge 1', category: 'Lower' },
  { id: 's03a_lb3', name: 'Lower Bridge 3', category: 'Lower' },
  { id: 's03a_lc1', name: 'Lower Canyon 1', category: 'Lower' },
  { id: 's03a_lc2', name: 'Lower Canyon 2', category: 'Lower' },
  { id: 's03a_na1', name: 'North Area 1', category: 'North' },
  { id: 's03a_nb2', name: 'North Bridge 2', category: 'North' },
  { id: 's03a_nc2', name: 'North Canyon 2', category: 'North' },
  { id: 's03a_sa1', name: 'South Area 1', category: 'South' },
  { id: 's03a_tb3', name: 'Top Bridge 3', category: 'Top' },
  { id: 's03a_tc3', name: 'Top Canyon 3', category: 'Top' },
  { id: 's03a_td1', name: 'Top Domain 1', category: 'Top' },
  { id: 's03a_td2', name: 'Top Domain 2', category: 'Top' },
  { id: 's03a_xb2', name: 'East Bridge 2', category: 'East' },
];

// Snowfield E - Midpoint
const snowfieldESections = [
  { id: 's03e_ia1', name: 'Inner Area 1', category: 'Midpoint' },
];

// Snowfield B - Second set of stages
const snowfieldBSections = [
  { id: 's03b_ga1', name: 'Gateway', category: 'Gateway' },
  { id: 's03b_ib1', name: 'Inner Bridge 1', category: 'Inner' },
  { id: 's03b_ib2', name: 'Inner Bridge 2', category: 'Inner' },
  { id: 's03b_ic1', name: 'Inner Canyon 1', category: 'Inner' },
  { id: 's03b_ic3', name: 'Inner Canyon 3', category: 'Inner' },
  { id: 's03b_lb1', name: 'Lower Bridge 1', category: 'Lower' },
  { id: 's03b_lb3', name: 'Lower Bridge 3', category: 'Lower' },
  { id: 's03b_lc1', name: 'Lower Canyon 1', category: 'Lower' },
  { id: 's03b_lc2', name: 'Lower Canyon 2', category: 'Lower' },
  { id: 's03b_na1', name: 'North Area 1', category: 'North' },
  { id: 's03b_nb2', name: 'North Bridge 2', category: 'North' },
  { id: 's03b_nc2', name: 'North Canyon 2', category: 'North' },
  { id: 's03b_sa1', name: 'South Area 1', category: 'South' },
  { id: 's03b_tb3', name: 'Top Bridge 3', category: 'Top' },
  { id: 's03b_tc3', name: 'Top Canyon 3', category: 'Top' },
  { id: 's03b_td1', name: 'Top Domain 1', category: 'Top' },
  { id: 's03b_td2', name: 'Top Domain 2', category: 'Top' },
  { id: 's03b_xb2', name: 'East Bridge 2', category: 'East' },
];

// Snowfield Z - Boss area
const snowfieldZSections = [
  { id: 's03z_na1', name: 'North Area 1', category: 'Boss' },
];

const snowfieldTypes = [
  { key: 'a', name: 'Snowfield A - First Set', sections: snowfieldASections, color: '#1a4a6e' },
  { key: 'e', name: 'Snowfield E - Midpoint', sections: snowfieldESections, color: '#2d5a7a' },
  { key: 'b', name: 'Snowfield B - Second Set', sections: snowfieldBSections, color: '#3a6a8a' },
  { key: 'z', name: 'Snowfield Z - Boss Area', sections: snowfieldZSections, color: '#501616' },
];
---

<Layout title="Rioh Snowfield - All Sections">
  <style>
    body { overflow: auto !important; }
  </style>
  <div style="min-height: 100vh; background: linear-gradient(135deg, #1a4a6e 0%, #4a8ab0 100%); padding: 2rem; padding-bottom: 4rem;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <h1 style="color: white; font-family: monospace; margin-bottom: 2rem; text-align: center;">
        Rioh Snowfield - All Sections
      </h1>

      <div style="margin-bottom: 2rem; text-align: center;">
        <a
          href="/stage/wetlands"
          style="
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background: rgba(45, 80, 22, 0.9);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-family: monospace;
            margin: 0 0.5rem;
          "
        >
          Back to Wetlands
        </a>
        <a
          href="/stage/valley"
          style="
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background: rgba(100, 100, 200, 0.9);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-family: monospace;
            margin: 0 0.5rem;
          "
        >
          Back to Valley
        </a>
        <a
          href="/stage/warp"
          style="
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background: rgba(100, 50, 150, 0.9);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-family: monospace;
            margin: 0 0.5rem;
          "
        >
          Back to Warp
        </a>
      </div>

      {snowfieldTypes.map(snowfieldType => (
        <div key={snowfieldType.key} style="margin-bottom: 3rem;">
          <h2 style={`
            color: white;
            font-family: monospace;
            font-size: 1.4rem;
            margin-bottom: 1.5rem;
            padding: 0.75rem 1rem;
            background: ${snowfieldType.color};
            border-radius: 8px;
          `}>
            {snowfieldType.name}
          </h2>
          <div style="
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 1rem;
          ">
            {snowfieldType.sections.map(section => (
              <a
                key={section.id}
                href={`/stage/snowfield-${section.id}`}
                style="
                  display: block;
                  padding: 1rem;
                  background: rgba(255, 255, 255, 0.1);
                  color: white;
                  text-decoration: none;
                  border-radius: 8px;
                  font-family: monospace;
                  transition: all 0.3s ease;
                  border: 2px solid transparent;
                "
                onmouseover="this.style.background='rgba(255, 255, 255, 0.2)'; this.style.borderColor='rgba(255, 255, 255, 0.5)';"
                onmouseout="this.style.background='rgba(255, 255, 255, 0.1)'; this.style.borderColor='transparent';"
              >
                <div style="font-weight: bold; margin-bottom: 0.25rem;">
                  {section.name}
                </div>
                <div style="font-size: 0.85rem; color: rgba(255, 255, 255, 0.7);">
                  {section.id}
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}

      <div style="text-align: center; margin-top: 3rem;">
        <a
          href="/"
          style="
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background: rgba(200, 50, 50, 0.9);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-family: monospace;
          "
        >
          Back to Home
        </a>
      </div>
    </div>
  </div>
</Layout>
