---
import Layout from '../../layouts/Layout.astro';
import ValleyArea from '../../components/valley/ValleyArea';
import MapTrigger from '../../components/valley/MapTrigger';

export const prerender = false;
---

<Layout title="Gurhacia Valley - Inner Bridge 1">
  <ValleyArea
    mapId="s01a_ib1"
    mapName="Gurhacia Valley - Inner Bridge 1"
    client:load
  >
    {/* North trigger - leads back to valley index */}
    <MapTrigger
      position={[-17.06, 1.00, -27.61]}
      targetUrl="/stage/valley"
      label="North Exit"
      client:only="react"
    />

    {/* South trigger - leads back to valley index */}
    <MapTrigger
      position={[14.14, 1.00, 27.79]}
      targetUrl="/stage/valley"
      label="South Exit"
      client:only="react"
    />
  </ValleyArea>
</Layout>
