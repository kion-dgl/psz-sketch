---
import Layout from '../../layouts/Layout.astro';
import ValleyArea from '../../components/valley/ValleyArea';

export const prerender = false;
---

<Layout title="Gurhacia Valley - Inner Bridge 1">
  <ValleyArea
    mapId="s01a_ib1"
    mapName="Gurhacia Valley - Inner Bridge 1"
    triggers={[
      {
        position: [-17.06, 1.00, -27.61],
        targetUrl: "/stage/valley",
        label: "North Exit"
      },
      {
        position: [14.14, 1.00, 27.79],
        targetUrl: "/stage/valley",
        label: "South Exit"
      }
    ]}
    client:load
  />
</Layout>
