---
import Layout from '../../layouts/Layout.astro';
import ValleyArea from '../../components/valley/ValleyArea';

export const prerender = false;

const objects = {
  gates: [
    { edge: "north" as const, x: -17, z: -27, scale: 1 },
    { edge: "east" as const, x: 27, z: -3, scale: 1 },
    { edge: "south" as const, x: 12, z: 27, scale: 1 },
    { edge: "west" as const, x: -27, z: 16, scale: 1 },
  ],
};

const spawnPoints = [
  { position: [-17, 1, -24] as [number, number, number], rotation: 0, label: "North Gate" },
  { position: [24, 1, -3] as [number, number, number], rotation: -1.5707963267948966, label: "East Gate" },
  { position: [12, 1, 24] as [number, number, number], rotation: 3.141592653589793, label: "South Gate" },
  { position: [-24, 1, 16] as [number, number, number], rotation: 1.5707963267948966, label: "West Gate" },
];

const triggers = [
  { position: [-17, 1, -29] as [number, number, number], rotation: 0, targetUrl: "/stage/valley", label: "North Gate" },
  { position: [29, 1, -3] as [number, number, number], rotation: -1.5707963267948966, targetUrl: "/stage/valley", label: "East Gate" },
  { position: [12, 1, 29] as [number, number, number], rotation: 3.141592653589793, targetUrl: "/stage/valley", label: "South Gate" },
  { position: [-29, 1, 16] as [number, number, number], rotation: 1.5707963267948966, targetUrl: "/stage/valley", label: "West Gate" },
];
---

<Layout title="Gurhacia Valley - s01a_xb2">
  <ValleyArea
    mapId="s01a_xb2"
    mapName="Gurhacia Valley - s01a_xb2"
    spawnPosition={spawnPoints[0].position}
    spawnRotation={spawnPoints[0].rotation}
    spawnPoints={spawnPoints}
    triggers={triggers}
    objects={objects}
    client:load
  />
</Layout>
