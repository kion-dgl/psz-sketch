---
import Layout from '../../layouts/Layout.astro';
import ValleyArea from '../../components/valley/ValleyArea';

export const prerender = false;

const objects = {
  gates: [
    { edge: "north" as const, x: 14, z: -27, scale: 1 },
  ],
};

const spawnPoints = [
  { position: [14, 1, -24] as [number, number, number], rotation: 0, label: "North Gate" },
];

const triggers = [
  { position: [14, 1, -29] as [number, number, number], rotation: 0, targetUrl: "/stage/valley", label: "North Gate" },
];
---

<Layout title="Gurhacia Valley - s01a_lc2">
  <ValleyArea
    mapId="s01a_lc2"
    mapName="Gurhacia Valley - s01a_lc2"
    spawnPosition={spawnPoints[0].position}
    spawnRotation={spawnPoints[0].rotation}
    spawnPoints={spawnPoints}
    triggers={triggers}
    objects={objects}
    client:load
  />
</Layout>
