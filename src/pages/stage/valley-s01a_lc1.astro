---
import Layout from '../../layouts/Layout.astro';
import ValleyArea from '../../components/valley/ValleyArea';

export const prerender = false;

const objects = {
  gates: [
    { edge: "north" as const, x: -13.5, z: -25, scale: 1 },
    { edge: "east" as const, x: 25, z: 13.5, scale: 1 },
  ],
};

const spawnPoints = [
  { position: [-13.5, 1, -22] as [number, number, number], rotation: 0, label: "North Gate" },
  { position: [22, 1, 13.5] as [number, number, number], rotation: 1.5707963267948966, label: "East Gate" },
];

const triggers = [
  { position: [-13.5, 1, -27] as [number, number, number], rotation: 0, targetUrl: "/stage/valley", label: "North Gate" },
  { position: [27, 1, 13.5] as [number, number, number], rotation: 1.5707963267948966, targetUrl: "/stage/valley", label: "East Gate" },
];
---

<Layout title="Gurhacia Valley - s01a_lc1">
  <ValleyArea
    mapId="s01a_lc1"
    mapName="Gurhacia Valley - s01a_lc1"
    spawnPosition={spawnPoints[0].position}
    spawnRotation={spawnPoints[0].rotation}
    spawnPoints={spawnPoints}
    triggers={triggers}
    objects={objects}
    client:load
  />
</Layout>
