---
import Layout from '../layouts/Layout.astro';
import CharacterCreationForm from '../components/character/CharacterCreationForm';

export const prerender = false;

// Get slot from URL query parameter
const url = new URL(Astro.request.url);
const slotParam = url.searchParams.get('slot');
const slot = slotParam ? parseInt(slotParam) : -1;

// Validate slot
if (isNaN(slot) || slot < 0 || slot > 3) {
  return Astro.redirect('/character-select');
}
---

<Layout title="Create Character - Density Dwarf">
  <div class="h-screen bg-gradient-to-b from-[#1e3a8a] to-[#3b82f6] p-6 flex items-center justify-center relative overflow-hidden">
    <div class="w-full max-w-[1400px] h-full max-h-[900px] flex items-center justify-center">
      <CharacterCreationForm client:load slot={slot} />
    </div>
  </div>
</Layout>
