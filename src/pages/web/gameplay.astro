 */
import GamePlayWeb from '../../components/web/GamePlayWeb';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gameplay Test - Phantasy Star Zero</title>
  <style>
