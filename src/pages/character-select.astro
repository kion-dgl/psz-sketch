---
import Layout from '../layouts/Layout.astro';
import CharacterSelectGrid from '../components/character/CharacterSelectGrid';

export const prerender = false;
---

<Layout title="Character Select - Density Dwarf">
  <div class="min-h-screen flex flex-col items-center justify-center bg-gradient-to-b from-blue-400 via-blue-500 to-blue-600 text-white px-8 py-12">
    <div class="bg-gradient-to-b from-blue-900 to-blue-800 border-4 border-gray-700 rounded-t-xl px-12 py-6 shadow-lg -mb-2 z-10">
      <h1 class="text-5xl font-mono font-bold tracking-widest drop-shadow-lg">Select File</h1>
    </div>

    <CharacterSelectGrid client:load />
  </div>
</Layout>
