---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const sections = [
  {
    title: 'Storybook',
    links: [
      { href: '/storybook', label: 'Storybook', description: 'Preview stages and elements', color: '#8855ff' },
      { href: '/storybook/stages', label: 'Stage Storybook', description: 'Browse all stages with dropdowns', color: '#aa55ff' },
      { href: '/storybook/weapons', label: 'Weapon Gallery', description: 'Browse 138 weapon models with 3D preview', color: '#ff5588' },
    ]
  },
  {
    title: 'Editors',
    links: [
      { href: '/stage/stage-editor', label: 'Stage Editor', description: 'Edit floor collision, portals, and export GLB', color: '#ff8844' },
      { href: '/preview-mission', label: 'Mission Preview', description: 'Walk through stage loading', color: '#ff55aa' },
      { href: '/grid', label: 'Grid Viewer', description: 'Test gate alignment in 5x5 grid', color: '#55aaaa' },
    ]
  },
  {
    title: 'Stage Views',
    links: [
      { href: '/stage/warp', label: 'Warp Hub', description: 'Teleport to different areas', color: '#5588ff' },
      { href: '/stage/counter', label: 'Guild Counter', description: 'Start quests and missions', color: '#55aa55' },
      { href: '/stage/valley', label: 'Gurhacia Valley', description: 'Valley stage hub', color: '#aa8855' },
      { href: '/stage/wetlands', label: 'Ozette Wetlands', description: 'Wetlands stage hub', color: '#558855' },
      { href: '/stage/snowfield', label: 'Rioh Snowfield', description: 'Snowfield stage hub', color: '#5588aa' },
      { href: '/stage/makara', label: 'Makara Ruins', description: 'Makara stage hub', color: '#aa5544' },
      { href: '/stage/paru', label: 'Oblivion City Paru', description: 'Paru stage hub', color: '#55aa44' },
      { href: '/stage/arca', label: 'Arca Plant', description: 'Arca stage hub', color: '#888888' },
      { href: '/stage/shrine', label: 'Dark Shrine', description: 'Shrine stage hub', color: '#6644aa' },
      { href: '/stage/tower', label: 'Eternal Tower', description: 'Tower stage hub', color: '#ffaa44' },
    ]
  },
  {
    title: 'Title',
    links: [
      { href: '/title', label: 'Title Screen', description: 'Game title screen', color: '#aa5555' },
    ]
  },
];
---

<Layout title="PSZ Sketch - Home">
  <div class="container">
    <h1>PSZ Sketch</h1>
    <p class="subtitle">Development Hub</p>

    {sections.map(section => (
      <section class="section">
        <h2 class="section-title">{section.title}</h2>
        <div class="links">
          {section.links.map(link => (
            <a href={link.href} class="link-card" style={`--card-color: ${link.color}`}>
              <span class="link-label">{link.label}</span>
              <span class="link-description">{link.description}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>

<style is:global>
  body {
    overflow: auto !important;
  }
</style>

<style>
  .container {
    min-height: 100vh;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    color: white;
    font-family: 'Segoe UI', system-ui, sans-serif;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    background: linear-gradient(90deg, #88aaff, #aa88ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    color: #888;
    margin-bottom: 2rem;
  }

  .section {
    width: 100%;
    max-width: 900px;
    margin-bottom: 2rem;
  }

  .section-title {
    font-size: 1.1rem;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    max-width: 900px;
    width: 100%;
  }

  .link-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s ease;
    border-left: 4px solid var(--card-color);
  }

  .link-card:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .link-label {
    color: white;
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .link-description {
    color: #888;
    font-size: 0.9rem;
  }
</style>
